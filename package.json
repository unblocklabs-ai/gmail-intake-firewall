{
  "name": "@unblocklabs/gmail-intake-firewall",
  "version": "0.1.6",
  "description": "OpenClaw plugin that classifies Gmail intake before agent exposure, quarantines risky mail, and routes safe mail by policy.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unblocklabs-ai/gmail-intake-firewall.git"
  },
  "homepage": "https://github.com/unblocklabs-ai/gmail-intake-firewall",
  "bugs": {
    "url": "https://github.com/unblocklabs-ai/gmail-intake-firewall/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "gmail",
    "email",
    "security",
    "router"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check:runtime": "npm run build && npm run typecheck && npm test",
    "check:inspector": "node scripts/check-inspector.mjs",
    "plugin:inspect": "plugin-inspector check --config plugin-inspector.config.json --no-openclaw --out reports/plugin-inspector",
    "plugin:inspect:runtime": "plugin-inspector check --config plugin-inspector.config.json --no-openclaw --runtime --mock-sdk --allow-execute --out reports/plugin-inspector",
    "marketplace:sync": "node scripts/sync-marketplace-package.mjs",
    "marketplace:check": "node scripts/sync-marketplace-package.mjs --check",
    "check:install": "npm run marketplace:check && node scripts/check-install.mjs",
    "pack:check": "npm pack --dry-run",
    "preflight": "npm run check:runtime && npm run marketplace:sync && npm run check:inspector && npm run check:install && npm run pack:check",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "openclaw.plugin.json",
    ".claude-plugin/marketplace.json"
  ],
  "dependencies": {
    "@slack/web-api": "^7.15.0",
    "googleapis": "^166.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": ">=11.0.0"
  },
  "devDependencies": {
    "@openclaw/plugin-inspector": "^0.3.10",
    "@types/node": "^24.6.0",
    "openclaw": "2026.5.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.3",
      "minGatewayVersion": "2026.5.3"
    },
    "build": {
      "openclawVersion": "2026.5.3",
      "pluginSdkVersion": "2026.5.3"
    },
    "install": {
      "npmSpec": "@unblocklabs/gmail-intake-firewall",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.3"
    },
    "release": {
      "publishToClawHub": false,
      "publishToNpm": true
    }
  }
}
