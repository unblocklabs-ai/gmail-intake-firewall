{
  "id": "gmail-intake-firewall",
  "name": "Gmail Intake Firewall",
  "version": "0.1.12",
  "description": "Classifies Gmail intake before agent exposure, quarantines risky mail, and routes safe mail by explicit policy.",
  "enabledByDefault": false,
  "kind": [
    "service",
    "tool"
  ],
  "activation": {
    "onStartup": true,
    "onRoutes": [
      "gateway-webhook"
    ],
    "onCapabilities": [
      "tool"
    ]
  },
  "contracts": {
    "tools": [
      "gmail_intake_firewall_status",
      "gmail_intake_firewall_review"
    ]
  },
  "uiHints": {
    "enabled": {
      "label": "Enabled",
      "help": "Enable Gmail intake monitoring."
    },
    "dryRun": {
      "label": "Dry Run",
      "help": "Record intended Gmail, Slack, and wake actions without executing them."
    },
    "actions.gmail.label.mode": {
      "label": "Gmail Label Mode",
      "help": "Controls live execution for applying Gmail labels. dryRun overrides this globally."
    },
    "actions.gmail.archive.mode": {
      "label": "Gmail Archive Mode",
      "help": "Controls live execution for removing messages from inbox. dryRun overrides this globally."
    },
    "actions.slack.alert.mode": {
      "label": "Slack Alert Mode",
      "help": "Controls live execution for Slack security alerts. dryRun overrides this globally."
    },
    "actions.wake.agent.mode": {
      "label": "Agent Wake Mode",
      "help": "Controls live execution for immediate agent wakes. dryRun overrides this globally."
    },
    "actions.wake.aggregate.mode": {
      "label": "Aggregate Wake Mode",
      "help": "Controls live execution for digest wakes. dryRun overrides this globally."
    },
    "statePath": {
      "label": "State Path",
      "help": "Deprecated JSON fallback path. Use SQLite Path."
    },
    "sqlitePath": {
      "label": "SQLite Path",
      "help": "Durable SQLite database for decisions, idempotency, aggregate queues, replay, and per-source state."
    },
    "openaiApiKeyRef": {
      "label": "OpenAI API Key Secret",
      "help": "SecretRef for OPENAI_API_KEY. Env and file refs work in the gateway path; host-injected resolvers are used when available."
    },
    "OPENAI_API_KEY": {
      "label": "OpenAI API Key",
      "help": "Fallback config-level OpenAI API key. Prefer openaiApiKeyRef when available.",
      "secret": true,
      "advanced": true
    },
    "webhookSecret": {
      "label": "Webhook Secret",
      "help": "Shared secret required by the Gmail Pub/Sub HTTP route. Pass as Bearer token, x-openclaw-token, or token query parameter.",
      "secret": true,
      "advanced": true
    },
    "openai_model": {
      "label": "OpenAI Model",
      "help": "OpenAI model used by the standalone security classifier."
    },
    "security.quarantineLabel": {
      "label": "Quarantine Label"
    },
    "security.archiveOnQuarantine": {
      "label": "Archive On Quarantine"
    },
    "security.model": {
      "label": "Security Model",
      "help": "Optional model override. When unset, the install default LLM provider/model is used."
    },
    "security.alertTarget": {
      "label": "Alert Target",
      "advanced": true
    },
    "security.includeSnippetInAlerts": {
      "label": "Include Snippet In Security Alerts",
      "help": "When enabled, suspicious-mail alerts may include Gmail's snippet. Disabled by default to avoid body excerpts in quarantine notifications.",
      "advanced": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "dryRun": {
        "type": "boolean",
        "default": true
      },
      "actions": {
        "type": "object",
        "additionalProperties": false,
        "default": {},
        "properties": {
          "gmail": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "label": { "$ref": "#/$defs/actionMode", "default": { "mode": "dry_run" } },
              "archive": { "$ref": "#/$defs/actionMode", "default": { "mode": "disabled" } },
              "removeLabel": { "$ref": "#/$defs/actionMode", "default": { "mode": "dry_run" } },
              "restoreInbox": { "$ref": "#/$defs/actionMode", "default": { "mode": "disabled" } }
            }
          },
          "slack": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "alert": { "$ref": "#/$defs/actionMode", "default": { "mode": "dry_run" } }
            }
          },
          "wake": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "agent": { "$ref": "#/$defs/actionMode", "default": { "mode": "dry_run" } },
              "aggregate": { "$ref": "#/$defs/actionMode", "default": { "mode": "dry_run" } }
            }
          },
          "local": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "log": { "$ref": "#/$defs/actionMode", "default": { "mode": "live" } }
            }
          }
        }
      },
      "statePath": {
        "type": "string",
        "default": "~/.openclaw/gmail-intake-firewall/state.json"
      },
      "sqlitePath": {
        "type": "string",
        "default": "~/.openclaw/gmail-intake-firewall/state.sqlite"
      },
      "openaiApiKeyRef": {
        "type": "object",
        "description": "SecretRef resolving to OPENAI_API_KEY or an object containing OPENAI_API_KEY/apiKey. Env and file refs are supported without a host resolver."
      },
      "OPENAI_API_KEY": {
        "type": "string",
        "description": "Fallback config-level OpenAI API key. Prefer openaiApiKeyRef."
      },
      "webhookSecret": {
        "type": "string",
        "description": "Shared secret required by the Gmail Pub/Sub HTTP route."
      },
      "openai_model": {
        "type": "string",
        "default": "gpt-5.5"
      },
      "sources": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "accountEmail": {
              "type": "string"
            },
            "authRef": {
              "type": "object",
              "description": "Gmail OAuth material, or a SecretRef resolving to JSON with refreshToken/clientId/clientSecret/scopes. Env and file refs are supported without a host resolver."
            },
            "credentialRef": {
              "type": "object",
              "description": "Alias for authRef."
            },
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "candidateQuery": {
              "type": "string"
            },
            "include": {
              "type": "string"
            },
            "exclude": {
              "type": "string"
            },
            "defaultRoutingPolicy": {
              "type": "string"
            },
            "intakeMode": {
              "type": "string",
              "enum": [
                "watch",
                "history",
                "poll"
              ],
              "default": "poll"
            },
            "watchTopicName": {
              "type": "string",
              "description": "Gmail Pub/Sub topic name for watch mode."
            },
            "historyLookback": {
              "type": "string",
              "description": "Reserved repair/backfill lookback hint for history mode."
            },
            "polling": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "intervalMs": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 60000
                },
                "maxResults": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 25
                }
              },
              "default": {}
            },
            "gmailActions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hasModifyScope": {
                  "type": "boolean",
                  "default": true,
                  "description": "Set false when auth only has Gmail read scope; actions.*.mode remains the execution policy, but Gmail mutations will be skipped for this source."
                }
              },
              "default": {}
            }
          },
          "required": [
            "id",
            "accountEmail"
          ]
        }
      },
      "security": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quarantineLabel": {
            "type": "string",
            "default": "OpenClaw/Quarantine"
          },
          "provider": {
            "type": "string",
            "description": "Optional LLM provider override. Defaults to the install's configured LLM provider."
          },
          "model": {
            "type": "string",
            "description": "Optional LLM model override. Defaults to the install's configured model."
          },
          "maxBodyChars": {
            "type": "integer",
            "minimum": 1,
            "default": 24000
          },
          "maliciousThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.65
          },
          "uncertainThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.35
          },
          "failClosedOnUncertain": {
            "type": "boolean",
            "default": true,
            "description": "When true, uncertain security classifications quarantine regardless of numeric risk score."
          },
          "includeSnippetInAlerts": {
            "type": "boolean",
            "default": false,
            "description": "When true, suspicious-mail alerts may include Gmail's snippet. Full body is never included."
          },
          "alertTarget": {
            "type": "string"
          },
          "archiveOnQuarantine": {
            "type": "boolean",
            "default": false
          }
        },
        "default": {}
      },
      "tags": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "gmailLabel": {
              "type": "string"
            },
            "wakeMode": {
              "type": "string",
              "enum": [
                "none",
                "wake_now",
                "aggregate"
              ]
            },
            "aggregateCadence": {
              "type": "string"
            },
            "wakeTarget": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "description",
            "wakeMode"
          ]
        }
      },
      "wakeTargets": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "agentId": {
              "type": "string"
            },
            "workspaceDir": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "deliveryContext": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "agentId"
          ]
        }
      },
      "alertSinks": {
        "type": "array",
        "default": [
          {
            "id": "local",
            "kind": "local_log",
            "enabled": true
          }
        ],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "slack",
                "local_log"
              ]
            },
            "target": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "id",
            "kind"
          ]
        }
      },
      "aggregate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxDigestItems": {
            "type": "integer",
            "minimum": 1,
            "default": 50
          },
          "timezone": {
            "type": "string",
            "default": "UTC"
          }
        },
        "default": {}
      },
      "artifacts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "analyzeLinks": {
            "type": "boolean",
            "default": true,
            "description": "Run local non-fetching structural link analysis."
          },
          "analyzeAttachments": {
            "type": "boolean",
            "default": true,
            "description": "Run local metadata-only attachment analysis."
          },
          "fetchLinks": {
            "type": "boolean",
            "default": false,
            "description": "Reserved for future sandboxing; must remain false in this version."
          },
          "downloadAttachments": {
            "type": "boolean",
            "default": false,
            "description": "Reserved for future sandboxing; must remain false in this version."
          },
          "maxDisplayedUrlChars": {
            "type": "integer",
            "minimum": 1,
            "default": 160
          }
        },
        "default": {}
      },
      "watch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "autoSetup": {
            "type": "boolean",
            "default": true,
            "description": "Automatically create or renew Gmail watches for watch-mode sources during runtime polling."
          },
          "renewBeforeMs": {
            "type": "integer",
            "minimum": 1,
            "default": 86400000,
            "description": "Renew Gmail watches this many milliseconds before Gmail's reported expiration."
          },
          "repairOnNoNotificationMs": {
            "type": "integer",
            "minimum": 1,
            "default": 21600000,
            "description": "Mark watch sources repair-due after this long without notification/history/repair activity."
          },
          "labelIds": {
            "type": "array",
            "default": [
              "INBOX"
            ],
            "items": {
              "type": "string"
            },
            "description": "Gmail labels used when registering the watch."
          },
          "labelFilterBehavior": {
            "type": "string",
            "enum": [
              "INCLUDE",
              "EXCLUDE"
            ],
            "default": "INCLUDE"
          }
        },
        "default": {}
      }
    },
    "$defs": {
      "actionMode": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "live",
              "dry_run",
              "disabled"
            ]
          }
        },
        "required": [
          "mode"
        ]
      }
    }
  }
}
